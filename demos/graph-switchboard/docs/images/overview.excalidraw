{
  "type": "excalidraw",
  "version": 2,
  "source": "https://github.com/Jbetts05/decision-models",
  "appState": {"viewBackgroundColor": "#ffffff"},
  "elements": [
    {
      "type": "text", "id": "title", "x": 40, "y": 10, "width": 1000, "height": 70,
      "text": "Graph Switchboard: one problem, two independent approaches",
      "fontSize": 24, "fontFamily": 2, "strokeColor": "#000000",
      "textAlign": "left", "verticalAlign": "top"
    },
    {
      "type": "rectangle", "id": "input", "x": 40, "y": 250, "width": 200, "height": 190,
      "strokeColor": "#1864ab", "backgroundColor": "#a5d8ff", "fillStyle": "solid",
      "strokeWidth": 1, "roundness": {"type": 3},
      "boundElements": [{"type": "text", "id": "input-label"}]
    },
    {
      "type": "text", "id": "input-label", "containerId": "input",
      "x": 50, "y": 260, "width": 180, "height": 175,
      "text": "Customer problem\nSelected vehicle\nAvailable observations\nAll supplied upfront",
      "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "textAlign": "center", "verticalAlign": "middle"
    },
    {
      "type": "rectangle", "id": "md1", "x": 300, "y": 110, "width": 270, "height": 190,
      "strokeColor": "#0c8599", "backgroundColor": "#99e9f2", "fillStyle": "solid",
      "strokeWidth": 1, "roundness": {"type": 3},
      "boundElements": [{"type": "text", "id": "md1-label"}]
    },
    {
      "type": "text", "id": "md1-label", "containerId": "md1",
      "x": 310, "y": 120, "width": 250, "height": 175,
      "text": "MD1 + Python controller\nSelect applicable published entry\nChoose supported branches\nFixed parameterised Cypher",
      "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "textAlign": "center", "verticalAlign": "middle"
    },
    {
      "type": "rectangle", "id": "sol", "x": 300, "y": 390, "width": 270, "height": 190,
      "strokeColor": "#e67700", "backgroundColor": "#fff3bf", "fillStyle": "solid",
      "strokeWidth": 1, "roundness": {"type": 3},
      "boundElements": [{"type": "text", "id": "sol-label"}]
    },
    {
      "type": "text", "id": "sol-label", "containerId": "sol",
      "x": 310, "y": 400, "width": 250, "height": 175,
      "text": "Independent Sol\nGenerate read-only Cypher\nInspect returned graph data\nQuery further or answer",
      "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "textAlign": "center", "verticalAlign": "middle"
    },
    {
      "type": "rectangle", "id": "graph", "x": 640, "y": 230, "width": 280, "height": 240,
      "strokeColor": "#1864ab", "backgroundColor": "#a5d8ff", "fillStyle": "solid",
      "strokeWidth": 1, "roundness": {"type": 3},
      "boundElements": [{"type": "text", "id": "graph-label"}]
    },
    {
      "type": "text", "id": "graph-label", "containerId": "graph",
      "x": 650, "y": 240, "width": 260, "height": 210,
      "text": "PostgreSQL + Apache AGE\nShared published graph\nConditions / Actions / Root causes\nVehicle applicability\nProcedures + provenance",
      "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "textAlign": "center", "verticalAlign": "middle"
    },
    {
      "type": "rectangle", "id": "output", "x": 990, "y": 250, "width": 250, "height": 190,
      "strokeColor": "#2f9e44", "backgroundColor": "#b2f2bb", "fillStyle": "solid",
      "strokeWidth": 1, "roundness": {"type": 3},
      "boundElements": [{"type": "text", "id": "output-label"}]
    },
    {
      "type": "text", "id": "output-label", "containerId": "output",
      "x": 1000, "y": 260, "width": 230, "height": 175,
      "text": "Recommendation per lane\nNext check or clarification\nHandoff or supported finding\nInspectable route + evidence",
      "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "textAlign": "center", "verticalAlign": "middle"
    },
    {
      "type": "arrow", "id": "input-md1", "x": 240, "y": 310, "width": 60, "height": 105,
      "points": [[0, 0], [30, 0], [30, -105], [60, -105]],
      "strokeColor": "#0c8599", "strokeWidth": 2, "endArrowhead": "arrow",
      "startBinding": {"elementId": "input", "focus": -0.36, "gap": 1},
      "endBinding": {"elementId": "md1", "focus": 0, "gap": 1}
    },
    {
      "type": "arrow", "id": "input-sol", "x": 240, "y": 380, "width": 60, "height": 105,
      "points": [[0, 0], [30, 0], [30, 105], [60, 105]],
      "strokeColor": "#e67700", "strokeWidth": 2, "endArrowhead": "arrow",
      "startBinding": {"elementId": "input", "focus": 0.36, "gap": 1},
      "endBinding": {"elementId": "sol", "focus": 0, "gap": 1}
    },
    {
      "type": "arrow", "id": "md1-graph", "x": 570, "y": 205, "width": 70, "height": 90,
      "points": [[0, 0], [35, 0], [35, 90], [70, 90]],
      "strokeColor": "#0c8599", "strokeWidth": 2, "endArrowhead": "arrow",
      "startBinding": {"elementId": "md1", "focus": 0, "gap": 1},
      "endBinding": {"elementId": "graph", "focus": -0.45, "gap": 1}
    },
    {
      "type": "arrow", "id": "sol-graph", "x": 570, "y": 485, "width": 70, "height": 90,
      "points": [[0, 0], [35, 0], [35, -90], [70, -90]],
      "strokeColor": "#e67700", "strokeWidth": 2, "endArrowhead": "arrow",
      "startBinding": {"elementId": "sol", "focus": 0, "gap": 1},
      "endBinding": {"elementId": "graph", "focus": 0.45, "gap": 1}
    },
    {
      "type": "arrow", "id": "graph-output", "x": 920, "y": 345, "width": 70, "height": 0,
      "points": [[0, 0], [70, 0]],
      "strokeColor": "#2f9e44", "strokeWidth": 2, "endArrowhead": "arrow",
      "startBinding": {"elementId": "graph", "focus": 0, "gap": 1},
      "endBinding": {"elementId": "output", "focus": 0, "gap": 1}
    },
    {
      "type": "text", "id": "caption", "x": 40, "y": 620, "width": 1200, "height": 70,
      "text": "Live in the app: retrieved graph / selected route / source evidence / time / estimated cost\nFictional guidance. Architecture illustration, not a performance benchmark.",
      "fontSize": 14, "fontFamily": 2, "strokeColor": "#000000",
      "textAlign": "left", "verticalAlign": "top"
    }
  ]
}
